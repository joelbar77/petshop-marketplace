# Base de datos (SQLite local por defecto)
DATABASE_URL="postgresql://usuario:clave@ep-xxxxx.neon.tech/petshop?sslmode=require"

# Servidor
PORT=4000
FRONTEND_URL="https://petshop-marketplace.vercel.app"

# JWT para el login de admin
JWT_SECRET="cambiar-esto-por-un-secreto-largo-y-random"

# Mercado Pago
# Sacá tu Access Token en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxxx"

# URL pública del backend (para que Mercado Pago mande el webhook de pago).
# En local podés usar ngrok. En producción, la URL real de tu API.
BACKEND_PUBLIC_URL="https://tunombre.up.railway.app"
