# Base de datos Postgres (Neon, Railway Postgres, Supabase, etc).
# Copiá acá la "connection string" que te da el proveedor.
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Servidor
PORT=4000
FRONTEND_URL="http://localhost:5173"

# JWT para el login de admin
JWT_SECRET="cambiar-esto-por-un-secreto-largo-y-random"

# Mercado Pago
# Sacá tu Access Token en https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN="TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxxx"

# URL pública del backend (para que Mercado Pago mande el webhook de pago).
# En local podés usar ngrok. En producción, la URL real de tu API en Railway.
BACKEND_PUBLIC_URL="http://localhost:4000"
